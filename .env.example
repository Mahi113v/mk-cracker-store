PORT=5000
CLIENT_URL=http://localhost:8000

# MySQL (user must be allowed to CREATE DATABASE - root is fine for local)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
# Master database: stores companies + platform admin (auto created by: npm run migrate)
MASTER_DB=mk_master

JWT_SECRET=change_this_to_a_long_random_string

# Platform (super) admin - product owner login: /platform/login
PLATFORM_NAME=MK Platform Admin
PLATFORM_EMAIL=superadmin@mkcrackers.com
PLATFORM_PASSWORD=Super@123
