PORT=5000
CLIENT_URL=http://localhost:8000

# MySQL (user must be allowed to CREATE DATABASE - root is fine for local)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
# Master database: stores companies + platform admin (auto created by: npm run migrate)
MASTER_DB=mk_master

JWT_SECRET=change_this_to_a_long_random_string

# Platform (super) admin - product owner login: /platform/login
PLATFORM_NAME=MK Platform Admin
PLATFORM_EMAIL=superadmin@mkcrackers.com
PLATFORM_PASSWORD=Super@123

# ---------------- WhatsApp (optional) ----------------
# log      = nothing is sent, messages are only written to the whatsapp_log table (default / testing)
# cloud    = Meta WhatsApp Cloud API   (WA_CLOUD_TOKEN, WA_CLOUD_PHONE_ID, optional WA_CLOUD_TEMPLATE + WA_CLOUD_TEMPLATE_LANG)
# twilio   = Twilio WhatsApp           (TWILIO_SID, TWILIO_TOKEN, TWILIO_WHATSAPP_FROM e.g. +14155238886)
# gateway  = simple HTTP gateway described in .env (WA_GATEWAY_* below), e.g. cloudwhatsapp
# webhook  = any gateway: POST JSON {to, message, company, event} to WA_WEBHOOK_URL (optional WA_WEBHOOK_TOKEN)
WHATSAPP_PROVIDER=log
WA_CLOUD_TOKEN=
WA_CLOUD_PHONE_ID=
WA_CLOUD_TEMPLATE=
WA_CLOUD_TEMPLATE_LANG=en
TWILIO_SID=
TWILIO_TOKEN=
TWILIO_WHATSAPP_FROM=
WA_WEBHOOK_URL=
WA_WEBHOOK_TOKEN=
# Public website address used inside WhatsApp links (defaults to the first CLIENT_URL)
APP_URL=

# ---- gateway provider (WHATSAPP_PROVIDER=gateway) - copy the request format from your gateway's API page ----
# Example only, replace the parameter NAMES with the ones in your gateway docs:
WA_GATEWAY_URL=http://web.cloudwhatsapp.com/wapp/api/send
WA_GATEWAY_METHOD=GET
WA_GATEWAY_FORMAT=query
WA_GATEWAY_PARAMS={"apikey":"YOUR_API_KEY","mobile":"{{to}}","msg":"{{message}}"}
WA_GATEWAY_HEADERS=
WA_GATEWAY_SUCCESS=
